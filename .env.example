# Copy to .env and fill in what you need. Everything is optional: with no key Argus
# runs with its offline, deterministic reasoner.

# Claude (default model). Any LangChain provider works: openai:..., google_genai:..., ollama:...
ANTHROPIC_API_KEY=
ARGUS_MODEL=anthropic:claude-opus-5-5

# Where incidents (checkpoints) and incident memory are stored.
ARGUS_DATA_DIR=.argus

# Require "Authorization: Bearer <token>" on POST endpoints.
ARGUS_API_TOKEN=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=argus
